PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/bola_tech
# Set to true if your database host requires SSL (Neon, Supabase, Render, Railway ...)
PGSSL=false

# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# First admin account (created/updated by:  npm run seed). Password: 10+ characters, letters + numbers.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_ID=BOLA-ADMIN-CHANGE1234
ADMIN_PASSWORD=CHANGE_ME_NOW

# Shipping rules (EGP)
FREE_SHIPPING_THRESHOLD=3000
SHIPPING_FEE=80

# ── Security ────────────────────────────────────────────────────────────────
# Force every admin to enable two-step verification before the control center opens (recommended in production).
# REQUIRE_ADMIN_2FA=true

# ── Production only ─────────────────────────────────────────────────────────
# NODE_ENV=production
# TRUST_PROXY=1            # when behind a reverse proxy / hosting platform (Caddy, Nginx, Render, Railway...)
# COOKIE_SECURE=true       # default in production; set false ONLY to test production mode over plain http
# ALLOWED_ORIGINS=https://yourdomain.com

# ── Virtual assistant (optional) ────────────────────────────────────────────
# Empty key = the built-in catalog assistant (products, prices, budget, departments) — no cost, no external service.
# With a key the assistant also answers general questions, writes, translates, explains and summarizes.
# AI_PROVIDER=openai       # openai (any OpenAI-compatible endpoint) | anthropic
# AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# AI_MODEL=gpt-4o-mini     # for anthropic e.g. claude-haiku-4-5-20251001


# WebAuthn / Passkey admin login (fingerprint, Face ID, Windows Hello)
WEBAUTHN_RP_NAME=BOLA TECH
# For local development leave WEBAUTHN_RP_ID/ORIGIN blank; for production set exact host/origin.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
# After registering at least one admin device, set this to true to require a platform biometric/passkey for every admin API request.
REQUIRE_ADMIN_PASSKEY=false

# V21 Ultimate
WEBAUTHN_RP_NAME=BOLA TECH
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
